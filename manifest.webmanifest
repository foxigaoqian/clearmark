{
  "name": "ClearMark — Free Watermark Remover",
  "short_name": "ClearMark",
  "description": "ClearMark — Free Watermark Remover. Clean images & videos in your browser. No uploads, no accounts, no cloud.",
  "start_url": "./",
  "scope": "./",
  "id": "clearmark",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#0A0A0B",
  "theme_color": "#0A0A0B",
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "categories": ["graphics", "photo", "productivity", "utilities"],
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Remove a watermark",
      "short_name": "Remove",
      "url": "./",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "About",
      "url": "./about.html"
    }
  ]
}
